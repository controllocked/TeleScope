{
  "_description": "General-purpose rules (non-TI use cases). Use these if you want to monitor Telegram for jobs, scams, marketplace activity, outages, or moderation signals. Drop the rules you want into your config.json rules[] array.",
  "rules": [
    {
      "name": "Jobs - Junior/Intern (EN)",
      "keywords": [
        "junior",
        "intern",
        "internship",
        "trainee",
        "entry level",
        "graduate"
      ],
      "regex": [
        "\\b(junior|intern(ship)?|trainee|entry[- ]level|graduate)\\b"
      ],
      "exclude_keywords": [
        "senior",
        "lead",
        "principal",
        "staff",
        "cto",
        "5+ years",
        "7+ years",
        "10+ years"
      ],
      "tags": ["category:jobs"],
      "enabled": true
    },
    {
      "name": "Jobs - Python Backend",
      "keywords": [
        "python",
        "django",
        "fastapi",
        "flask",
        "backend"
      ],
      "regex": [
        "\\bpython\\b",
        "\\b(django|fastapi|flask)\\b"
      ],
      "exclude_keywords": [
        "php",
        "wordpress",
        "magento",
        "drupal"
      ],
      "tags": ["category:jobs"],
      "enabled": true
    },
    {
      "name": "Hiring - General (EN)",
      "keywords": [
        "hiring",
        "we are hiring",
        "looking for",
        "join our team",
        "vacancy"
      ],
      "regex": [
        "\\b(opening|role|position|apply|cv|resume)\\b"
      ],
      "exclude_keywords": [
        "not hiring",
        "no hiring",
        "hiring freeze",
        "positions closed"
      ],
      "tags": ["category:jobs"],
      "enabled": true
    },
    {
      "name": "Jobs - RU (вакансия/ищем)",
      "keywords": [
        "вакансия",
        "ищем",
        "требуется",
        "набираем",
        "работа",
        "отклик"
      ],
      "regex": [
        "\\b(ваканси(я|и)|ищем|требуется|набираем|отклик(и|нуться)?)\\b"
      ],
      "exclude_keywords": [
        "не ищем",
        "не нанимаем",
        "найм закрыт",
        "стоп найм"
      ],
      "tags": ["category:jobs", "lang:ru"],
      "enabled": true
    },
    {
      "name": "Marketplace - Selling/Buying (RU)",
      "keywords": [
        "продам",
        "куплю",
        "продаю",
        "обмен",
        "торг",
        "состояние",
        "доставка"
      ],
      "regex": [
        "\\b(продам|куплю|обмен(яю)?|торг)\\b"
      ],
      "exclude_keywords": [
        "продано",
        "sold",
        "не актуально",
        "закрыто"
      ],
      "tags": ["category:marketplace", "lang:ru"],
      "enabled": true
    },
    {
      "name": "Crypto - TON / Toncoin",
      "keywords": [
        "ton",
        "toncoin",
        "the open network",
        "$ton",
        "wallet",
        "airdrop"
      ],
      "regex": [
        "\\bTON\\b",
        "\\$TON\\b",
        "\\b(airdrop|wallet|seed phrase)\\b"
      ],
      "exclude_keywords": [
        "testnet",
        "devnet",
        "scam",
        "fraud"
      ],
      "tags": ["category:crypto"],
      "enabled": true
    },
    {
      "name": "Payments - Refund / Chargeback",
      "keywords": [
        "refund",
        "chargeback",
        "dispute",
        "reversal",
        "возврат",
        "чарджбек",
        "спор",
        "списали"
      ],
      "regex": [
        "\\b(refund|chargeback|dispute)\\b",
        "\\b(возврат\\w*|чарджбек\\w*|оспор\\w*)\\b"
      ],
      "exclude_keywords": [
        "no refund",
        "non-refundable",
        "без возврата"
      ],
      "tags": ["category:payments"],
      "enabled": true
    },
    {
      "name": "Urgency / Deadline",
      "keywords": [
        "urgent",
        "asap",
        "deadline",
        "today",
        "tomorrow",
        "срочно",
        "дедлайн",
        "сегодня",
        "завтра"
      ],
      "regex": [
        "\\b(urgent|asap|deadline)\\b",
        "\\b(срочно|дедлайн)\\b"
      ],
      "exclude_keywords": [
        "not urgent",
        "не срочно"
      ],
      "tags": ["category:urgency"],
      "enabled": true
    },
    {
      "name": "Scam / Phishing - Common Signals",
      "keywords": [
        "seed phrase",
        "verify your account",
        "support team",
        "login link",
        "введите код",
        "подтвердите аккаунт",
        "служба поддержки"
      ],
      "regex": [
        "\\b(seed phrase|mnemonic)\\b",
        "\\bverify(\\s+your)?\\s+account\\b",
        "\\b(подтверд(и|ите)\\s+аккаунт|введите\\s+код)\\b"
      ],
      "exclude_keywords": [
        "official",
        "announcement",
        "pinned"
      ],
      "tags": ["severity:high", "category:scam"],
      "enabled": true
    },
    {
      "name": "Moderation - Toxic Slurs (RU+EN)",
      "keywords": [
        "идиот",
        "дебил",
        "moron",
        "stupid"
      ],
      "regex": [
        "\\b(idiot|moron|stupid)\\b",
        "\\b(дебил|идиот)\\b"
      ],
      "exclude_keywords": [
        "quote",
        "цитата",
        "meme",
        "шутка"
      ],
      "tags": ["category:moderation"],
      "enabled": true
    },
    {
      "name": "System/Infra - Outage / Incident",
      "keywords": [
        "outage",
        "downtime",
        "incident",
        "degraded",
        "latency",
        "ошибка",
        "упало",
        "не работает"
      ],
      "regex": [
        "\\b(outage|downtime|incident)\\b",
        "\\b(упал[ао]?|лежит|не\\s+работает)\\b"
      ],
      "exclude_keywords": [
        "scheduled maintenance",
        "плановые работы"
      ],
      "tags": ["category:outage"],
      "enabled": true
    }
  ]
}
